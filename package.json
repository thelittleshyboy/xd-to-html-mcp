{
  "name": "xd-to-html-mcp-harness",
  "version": "0.1.0",
  "description": "Adobe XD MCP tools for DeepSeek Harness, including accurate rendering and interactive HTML export",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./server": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "OFFICIAL-CATALOG-SUBMISSION.md",
    "market/*.json",
    "dist/*.js"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "jszip": "^3.10.2",
    "zod": "^4.6.7"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thelittleshyboy/xd-to-html-mcp.git"
  },
  "homepage": "https://github.com/thelittleshyboy/xd-to-html-mcp",
  "bugs": { "url": "https://github.com/thelittleshyboy/xd-to-html-mcp/issues" },
  "keywords": ["deepseek-harness", "harness-bundle", "mcp", "adobe-xd"]
}
